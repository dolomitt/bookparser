#!/usr/bin/env bash
set -euo pipefail

download_if_missing() {
  local url="$1"
  local destination="$2"
  local label="$3"

  if [ -s "$destination" ]; then
    echo "$label already exists at $destination"
    return
  fi

  mkdir -p "$(dirname "$destination")"
  echo "Downloading $label to $destination"
  curl -fL --retry 5 --retry-delay 5 --connect-timeout 30 -o "${destination}.tmp" "$url"
  mv "${destination}.tmp" "$destination"
}

download_if_missing "$S2_MODEL_URL" "$S2_MODEL_PATH" "S2 Pro q8_0 model"
download_if_missing "$S2_TOKENIZER_URL" "$S2_TOKENIZER_PATH" "S2 Pro tokenizer"

exec /opt/s2.cpp/build/s2 \
  -m "$S2_MODEL_PATH" \
  -t "$S2_TOKENIZER_PATH" \
  --server \
  -H "$S2_HOST" \
  -P "$S2_PORT" \
  -c "$S2_CUDA_DEVICE" \
  -threads "$S2_THREADS" \
  -max-tokens "$S2_MAX_TOKENS"
