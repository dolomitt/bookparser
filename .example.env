# OpenAI-compatible AI Configuration

# Use any OpenAI-compatible /v1 endpoint, including Ollama's OpenAI API.
BOOKPARSER_OPENAI_ENDPOINTS=http://127.0.0.1:11434/v1
# BOOKPARSER_OPENAI_API_KEY=sk-your-key
BOOKPARSER_OPENAI_MODEL=translategemma:12b
BOOKPARSER_OPENAI_TIMEOUT=180000
BOOKPARSER_OPENAI_MAX_RETRIES=2
BOOKPARSER_OPENAI_MAX_TOKENS=10000
BOOKPARSER_OPENAI_SUMMARY_MAX_TOKENS=16000
# For Qwen thinking models, append /no_think to every AI request.
BOOKPARSER_OPENAI_DISABLE_THINKING=true
# Some OpenAI-compatible servers reject json_object and only accept text/json_schema.
BOOKPARSER_OPENAI_RESPONSE_FORMAT=text
BOOKPARSER_CONTEXT_MODE=full
# AI token analysis scope: learner excludes punctuation and most low-value tokens.
# Use "all" to send every token to the LLM.
BOOKPARSER_AI_TOKEN_SCOPE=learner
# Optional override for previous/next sentence count per side.
# If unset, defaults to 5 in full mode and 1 in compact mode.
# BOOKPARSER_CONTEXT_WINDOW=1

# Optional URL article extraction. Crawl4AI is tried first when configured,
# then Firecrawl, then a basic direct fetch.
CRAWL4AI_BASE_URL=http://192.168.1.43:11235
# CRAWL4AI_TOKEN=
CRAWL4AI_TIMEOUT=60000
# FIRECRAWL_API_KEY=fc-YOUR_API_KEY
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2
FIRECRAWL_TIMEOUT=45000

PORT=5000
UPLOAD_DIR=./imports
BOOKS_DIR=./books
VOICEVOX_HOST=192.168.1.43
VOICEVOX_PORT=50021
VOICEVOX_DEFAULT_SPEAKER=1

# TTS provider: voicevox, fish-speech, or s2-pro.
# s2-pro uses the local Docker service in docker-compose.s2-pro.yml.
# BOOKPARSER_TTS_PROVIDER=s2-pro
# Alignment provider: estimated, mfa, or qwen3.
# BOOKPARSER_TTS_ALIGNMENT_PROVIDER=qwen3
BOOKPARSER_TTS_CACHE_ENABLED=true
BOOKPARSER_TTS_CACHE_MAX_ENTRIES=100
S2_PRO_BASE_URL=http://127.0.0.1:3030
S2_PRO_TIMEOUT=180000
S2_PRO_MAX_NEW_TOKENS=512
S2_PRO_TEMPERATURE=0
S2_PRO_TOP_P=1
S2_PRO_TOP_K=1
# Optional voice cloning. Configure both values together.
# S2_PRO_REFERENCE_AUDIO_PATH=./references/male.wav
# S2_PRO_REFERENCE_TEXT=Transcript of the reference audio.

QWEN_ALIGNER_BASE_URL=http://127.0.0.1:8050
QWEN_ALIGNER_LANGUAGE=Japanese
QWEN_ALIGNER_TIMEOUT=180000
QWEN_ALIGNER_FALLBACK_TO_MFA=false
