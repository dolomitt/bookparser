# Ollama Configuration

BOOKPARSER_OLLAMA_HOST=127.0.0.1
BOOKPARSER_OLLAMA_PORT=11434
BOOKPARSER_OLLAMA_MODEL=translategemma:12b
BOOKPARSER_OLLAMA_TIMEOUT=180000
BOOKPARSER_OLLAMA_MAX_RETRIES=2
BOOKPARSER_OLLAMA_MAX_TOKENS=10000
BOOKPARSER_OLLAMA_SUMMARY_MAX_TOKENS=16000
BOOKPARSER_CONTEXT_MODE=full
# Optional override for previous/next sentence count per side.
# If unset, defaults to 5 in full mode and 1 in compact mode.
# BOOKPARSER_CONTEXT_WINDOW=1

# Optional URL article extraction. Crawl4AI is tried first when configured,
# then Firecrawl, then a basic direct fetch.
CRAWL4AI_BASE_URL=http://192.168.1.43:11235
# CRAWL4AI_TOKEN=
CRAWL4AI_TIMEOUT=60000
# FIRECRAWL_API_KEY=fc-YOUR_API_KEY
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2
FIRECRAWL_TIMEOUT=45000

PORT=5000
UPLOAD_DIR=./imports
BOOKS_DIR=./books
VOICEVOX_HOST=192.168.1.43
VOICEVOX_PORT=50021
VOICEVOX_DEFAULT_SPEAKER=1
